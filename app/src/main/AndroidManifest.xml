<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Round 1 "sites just work": requested on demand when a page asks for them. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Optional hardware — app still installs on devices without a camera/mic/GPS. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <!-- Read-only Wi-Fi state for Net ID MAC status (no MAC change capability). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Legacy (API <=28) write to public Downloads for CA / evidence exports.
         On API 29+ exports use MediaStore scoped storage and need no permission. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Package visibility (API 30+) for the confirmed Victorious Mesh app:
         install check, VPN owner-UID correlation, and bridge bind. -->
    <queries>
        <package android:name="com.victorious.mesh" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VictoriousBrowser"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VictoriousBrowser"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Open http(s) links from other apps (only http/https are accepted). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
            <!-- Share text containing a link → link preview / embed sheet. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Lite Apps: chrome-less single-panel host launched from pinned shortcuts.
             Not exported; each panel gets its own task (documentLaunchMode). -->
        <activity
            android:name=".liteapp.LiteAppActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:theme="@style/Theme.VictoriousBrowser"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Fleet control bridge: first-party EXTERNAL_NODE Messenger IPC.
             Exported so the owner's controller app can bind; access is gated by
             sendingUid + signing-cert allowlist + external-control switch. -->
        <service
            android:name=".bridge.FleetBridgeService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.victorious.browser.action.BRIDGE" />
            </intent-filter>
        </service>
    </application>
</manifest>
