<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VictoriousBrowser"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.VictoriousBrowser"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Lite Apps: chrome-less single-panel host launched from pinned shortcuts.
             Not exported; each panel gets its own task (documentLaunchMode). -->
        <activity
            android:name=".liteapp.LiteAppActivity"
            android:exported="false"
            android:documentLaunchMode="intoExisting"
            android:theme="@style/Theme.VictoriousBrowser"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout" />

        <!-- Fleet control bridge: first-party EXTERNAL_NODE Messenger IPC.
             Exported so the owner's controller app can bind; access is gated by
             sendingUid + signing-cert allowlist + external-control switch. -->
        <service
            android:name=".bridge.FleetBridgeService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.victorious.browser.action.BRIDGE" />
            </intent-filter>
        </service>
    </application>
</manifest>
